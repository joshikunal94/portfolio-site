// Cloudflare Workers (static assets) config — used by `npx wrangler deploy` in Workers Builds.
// The site is a pure static export (`next build` -> ./out); no Worker script, just assets.
// Security headers come from ./out/_headers (generated by scripts/gen-csp.mjs post-build).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio-site",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
